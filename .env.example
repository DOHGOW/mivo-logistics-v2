# GEMINI_API_KEY: Required for Gemini AI API calls.
# This is a placeholder key.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=MY_GEMINI_API_KEY

# FIREBASE_API_KEY: Web API Key for your Firebase project
FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY

# FIREBASE_PROJECT_ID: Project ID of your Firebase project (e.g. my-logistics-app)
FIREBASE_PROJECT_ID=YOUR_FIREBASE_PROJECT_ID

# FIREBASE_APPLICATION_ID: Mobile App ID of your Firebase Android App (e.g. 1:123:android:abc)
FIREBASE_APPLICATION_ID=YOUR_FIREBASE_APPLICATION_ID

# FIREBASE_DATABASE_URL: Realtime Database Reference URL (e.g. https://my-logistics-app-default-rtdb.firebaseio.com)
FIREBASE_DATABASE_URL=YOUR_FIREBASE_DATABASE_URL

